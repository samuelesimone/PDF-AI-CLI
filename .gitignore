# ── Secrets ────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example          # allow a committed template if you ever add one

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ── Virtual environments ────────────────────────────────────────────────────────
venv/
.venv/
env/
.env/          # directory named .env (distinct from the .env secrets file)
ENV/

# ── Test & coverage ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ── Vector index storage ────────────────────────────────────────────────────────
# Generated by llama-index; large, machine-specific, fully regeneratable.
storage/

# ── PDF files ──────────────────────────────────────────────────────────────────
# Do not commit user documents — they are private and potentially large.
*.pdf

# ── Model / ML caches (if ever written locally) ────────────────────────────────
*.safetensors
*.bin
*.gguf
*.ggml

# ── macOS ──────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── IDEs ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~